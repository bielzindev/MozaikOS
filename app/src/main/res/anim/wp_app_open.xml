<?xml version="1.0" encoding="utf-8"?>
<!-- Android apps opened from a tile: a short decelerating slide/fade that continues the turnstile. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:duration="260">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <translate android:fromXDelta="12%" android:toXDelta="0" />
    <scale android:fromXScale="0.94" android:toXScale="1" android:fromYScale="0.94" android:toYScale="1"
        android:pivotX="0%" android:pivotY="50%" />
</set>
