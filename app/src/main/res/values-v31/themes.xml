<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WpReborn" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/wp_black</item>
        <item name="android:colorBackground">@color/wp_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/wp_cobalt</item>
        <item name="android:windowShowWallpaper">false</item>
        <!-- Android 12+ draws its own splash (an icon) before every app. It is left plain
             black and empty, so the only splash seen is Mozaik's own, in the app's colour. -->
        <item name="android:windowSplashScreenBackground">@color/wp_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <style name="Theme.WpReborn.Lock">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
