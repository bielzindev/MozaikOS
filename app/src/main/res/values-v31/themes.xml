<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WpReborn" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/wp_black</item>
        <item name="android:colorBackground">@color/wp_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/wp_cobalt</item>
        <item name="android:windowShowWallpaper">false</item>
        <!-- Lumia-like splash: the accent tile on black. -->
        <item name="android:windowSplashScreenBackground">@color/wp_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/wp_cobalt</item>
    </style>

    <style name="Theme.WpReborn.Lock">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
