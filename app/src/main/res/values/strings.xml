    <string name="kb_try">Try it here</string>
    <string name="kb_tips">Tips: swipe left on backspace to delete a word; hold the space bar to switch keyboards; the globe key changes language when you use more than one; tap a suggestion right after Word Flow to replace the word; backspace right after an autocorrection undoes it.</string>
    <string name="kb_languages_hint">Choose the keyboard languages. Every Latin-script language also gets its accents by holding a key. Chinese is not available: use another keyboard for it.</string>
